---
/**
 * Wysiwyg
 *
 * Renders an Umbraco rich text field, applying optional per-tag transform rules.
 *
 * Props:
 *   content  — Umbraco rich text object ({ markup, blocks })
 *   rules    — optional map of { tagName: (node) => htmlString }
 *              Caller rules override defaults. Return null/undefined to keep the node as-is.
 *
 * Default rules:
 *   img — processed through wysiwygImageLoader()
 */

import { parse } from "node-html-parser";
import { wysiwygImageLoader } from "@/lib/Umbraco.Media";

const { content, rules = {}, imgSizes = "100vw" } = Astro.props;

const imgHandler = {
    img: (node) => wysiwygImageLoader(node, imgSizes),
};

const mergedRules = { ...imgHandler, ...rules };
const { markup } = content;

// Walks the tree depth-first, applying any matching rule to each element.
// Children are transformed before their parent so a parent rule sees final child HTML.
function applyRules(node) {
    if (node.nodeType === 3) return node.toString(); // text node — pass through

    const tag = node.rawTagName?.toLowerCase();
    if (!tag) return node.toString();

    // Transform children first
    node.childNodes.forEach((child) => {
        if (child.nodeType !== 3) {
            const replaced = applyRules(child);
            if (replaced !== child.toString()) {
                child.replaceWith(replaced);
            }
        }
    });

    if (mergedRules[tag]) {
        return mergedRules[tag](node) ?? node.toString();
    }

    return node.toString();
}

const root = parse(markup);
const transformed = root.childNodes.map(applyRules).join("");
---

<Fragment set:html={transformed} />
