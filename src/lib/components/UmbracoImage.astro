---
import { buildSrc, buildSrcSet } from "@/lib/Umbraco.Media";
import type { IApiMediaWithCropsModel } from "@/types/models/IApiMediaWithCropsModel";

interface Props extends astroHTML.JSX.ImgHTMLAttributes {
	/** The Umbraco media object returned by the Content Delivery API. */
	image?: IApiMediaWithCropsModel;
	/** Rendered width in pixels; defaults to the image's intrinsic width. */
	width?: number;
	/**
	 * A `sizes` attribute string passed straight to the `<img>` element.
	 * @example "(max-width: 768px) 100vw, 50vw"
	 */
	sizes?: string;
	/** Alt text; falls back to `image.name` when omitted. */
	alt?: string;
	/** Crop alias defined in Umbraco. When supplied, the matching crop ratio and focal-point are used. */
	crop?: string;
	loading?: "lazy" | "eager";
}

const { image, width, sizes, alt, crop, loading, ...rest } = Astro.props;

if (!image?.url) return;

const displayWidth = width ?? image.width ?? 0;
const { src, height } = buildSrc(image, displayWidth, crop);
const srcset = buildSrcSet(image, crop);
---

{image?.url &&
	<img
		alt={alt || image.name}
		src={src}
		width={width || image.width || undefined}
		height={height || image.height || undefined}
		srcset={srcset}
		sizes={sizes || null}
		loading={loading || "lazy"}
		decoding="async"
		{...rest}
	/>
}
