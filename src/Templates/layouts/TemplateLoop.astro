---
import { toPascalCase } from "../../js/helpers/helpers";
import {resolveTemplate} from "@/lib/Astro.Helpers";
// CREATE COLLECTION OF TEMPLATES TO TRACK FOR CHANGES
const templates = import.meta.glob('../pages/*.astro', { eager: true });

// GET MODEL DATA
const { model } = Astro.props;

// Function to dynamically load a template file
async function resolveTemplate(contentType: string) {
	const name = toPascalCase(contentType);
	const path = `../pages/${name}.astro`;
	const module = templates[path] as { default: unknown } | undefined;
	if (!module) throw new Error(`Template not found for content type "${contentType}" — expected ${path}`);
	return module.default;
}

// DYNAMICALLY LOAD TEMPLATE
const Template = await resolveTemplate(model.contentType, "../pages");
---

{Template ? (
		<Template {model} />
	) : (
		<Fragment>Missing template for {model?.contentType}</Fragment>
	)}


