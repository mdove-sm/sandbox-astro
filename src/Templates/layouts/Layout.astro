---
import { toSlug } from "../../js/helpers/helpers";
import "@/scss/global.scss";
import { fetchContent } from "@/lib/Umbraco.Query";
import UmbracoMeta from "@/lib/components/UmbracoMeta.astro";
import type { SiteSettingsContentResponseModel } from "@/types/models/SiteSettingsContentResponseModel";

const { model = {} } = Astro.props;

const settingsData = await fetchContent([
	"filter=contentType:siteSettings",
	"fields=properties[$all]",
]);
const settings: SiteSettingsContentResponseModel | undefined = settingsData?.items?.[0];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<UmbracoMeta model={model} settings={settings} />
	</head>
	<body>
		<div class="site" data-template={model?.contentType} data-page={toSlug(model?.name)}>
			<header class="site__header"></header>
			<main class="site__main">
				<slot />
			</main>
			<footer class="site__footer"></footer>
		</div>
	</body>
</html>
