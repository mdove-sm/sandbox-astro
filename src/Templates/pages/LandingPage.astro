---
import type { LandingPageContentResponseModel } from "@/types";
import BlocklistLoop from "../layouts/BlocklistLoop.astro";
import UmbracoImage from "@/lib/components/UmbracoImage.astro";
// import BlocklistLoop from "../layouts/BlocklistLoop.astro";


interface Props {
	model: LandingPageContentResponseModel;
}

const { model } = Astro.props;
---
<h1>{model.name} Page Title</h1>
<h2>{model.contentType} Template</h2>
{model.properties?.metaDescription && <p>{model.properties?.metaDescription}</p>}

{model.properties?.modules?.items?.length && <BlocklistLoop blocks={model.properties.modules.items} />}
