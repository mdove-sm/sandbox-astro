---
import type { HomeContentResponseModel } from "@/types";
import BlocklistLoop from "@/Templates/layouts/BlocklistLoop.astro";
import UmbracoImage from "@/lib/components/UmbracoImage.astro";

interface Props {
	model: HomeContentResponseModel;
}

const { model } = Astro.props;
---
<h1>{model.name} Page</h1>
<h2>{model.contentType} Template</h2>
{model.properties?.socialImage?.length && <UmbracoImage image={model.properties?.socialImage[0]} width="600" crop="16-9" sizes="(max-width: 600px) 100w, 600px" />}
{model.properties?.metaDescription && <p>{model.properties?.metaDescription}</p>}
{model.properties?.modules?.items?.length && <BlocklistLoop blocks={model.properties.modules.items} />}
