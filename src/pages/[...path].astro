---
import { fetchContent, fetchItem } from "@/lib/Umbraco.Query";
import Layout from "@/Templates/layouts/Layout.astro";
// import { toPascalCase } from "@/js/helpers/helpers";
// const templates = import.meta.glob('../Templates/pages/*.astro', { eager: true });
import TemplateLoop from "@/Templates/layouts/TemplateLoop.astro";

export const prerender = import.meta.env.PRERENDER === 'true';

// GET STATIC PATHS
export async function getStaticPaths() {
	// console.log("GET STATIC PATHS", test);
	const includeTypes = [
		"article",
		"articleListing",
		"document",
		"documentListing",
		"event",
		"eventListing",
		"job",
		"jobListing",
		"landingPage",
		"profile",
		"profileListing",
		"servicePage",
		"standardPage",
	];

	const data = await fetchContent(
		[
			`filter=contentType:${includeTypes.join(",")}`,
			`fields=properties[$all]`
		],
		true);

// console.log("PATHS:", data);
	return data?.items.map((item:any) => {
		return {
			params: { path: item.route.path },
			props: { item: item },
		};
	});
}

// CREATE MODEL DATA
let model = import.meta.env.PRERENDER === 'true' ? Astro.props.item : await fetchItem(Astro.params.path, ["fields=properties[$all]"]);
if (!model) return Astro.redirect('/404');

