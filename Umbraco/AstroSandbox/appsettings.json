{
	"$schema": "appsettings-schema.json",
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.Hosting.Lifetime": "Information",
				"System": "Warning"
			}
		}
	},
	"Umbraco": {
		"CMS": {
			"Global": {
				"Id": "e48646b3-5a4b-46f1-88a4-f8f58374c3f6"
			},
			"Content": {
				"AllowEditInvariantFromNonDefault": true,
				"ContentVersionCleanupPolicy": {
					"EnableCleanup": true
				}
			},
			"DeliveryApi": {
				"Enabled": true
			},
			"Unattended": {
				"UpgradeUnattended": true
			},
			"Security": {
				"AllowConcurrentLogins": false,
				"UsernameIsEmail": false
			}
		}
	},
	"DeliveryApiExtensions": {
		"Preview": {
			"Enabled": true,
			"Media": {
				"Enabled": true
			},
			"AllowedUserGroupAliases": [] // All allowed by default
		},
		"TypedSwagger": {
			"Enabled": true,
			"Mode": "Compatibility"
		}
	}
}
